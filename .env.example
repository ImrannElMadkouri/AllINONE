# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID
CLIENT_ID=
# Optional: register commands to one guild instantly while developing
DEV_GUILD_ID=

# AutoMod (optional). Requires the Message Content Intent in the Developer Portal.
OPENROUTER_API_KEY=
# OpenRouter model ID used by AutoMod
AUTOMOD_MODEL=
